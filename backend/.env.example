# Runtime
PORT=5000
NODE_ENV=production

# Required for persistent site data and leads
MONGODB_URI=your-mongodb-connection-string

# Allowed frontend origin for credentialed API requests
CLIENT_URL=https://your-frontend-domain.example.com

# Admin authentication secrets; keep these private
ADMIN_ID=your-admin-id
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=easylane_admin_session

# Optional xAI chatbot integration; keep the API key private
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_MS=12000

# Optional chatbot tuning
CHATBOT_KB_MIN_SCORE=220
CHATBOT_PROVIDER_COOLDOWN_MS=90000
